# =================================================================
# Enterprise ERP - Environment Variables Configuration
# =================================================================

# Versions
FRAPPE_VERSION=v15.40.0
ERPNEXT_VERSION=v15.38.0

# Site Configuration
FRAPPE_SITE_NAME_HEADER=erp.local
SITENAME=erp.local
ADMIN_PASSWORD=admin
ROUTER_PORT=80
ROUTER_SSL_PORT=443

# Database (MariaDB)
DB_ROOT_PASSWORD=mariadb_root_secret_password
DB_PASSWORD=frappe_db_password
DB_NAME=enterprise_erp_db
DB_HOST=mariadb
DB_PORT=3306

# Redis
REDIS_CACHE_HOST=redis-cache
REDIS_CACHE_PORT=6379
REDIS_QUEUE_HOST=redis-queue
REDIS_QUEUE_PORT=6379
REDIS_SOCKETIO_HOST=redis-socketio
REDIS_SOCKETIO_PORT=6379

# Mail Configuration (Optional SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_LOGIN=
MAIL_PASSWORD=
AUTO_EMAIL_ID=noreply@example.com
